# Local: copy to .env at the repository root; never commit real values.
APP_ENV=development
DATABASE_URL=mysql+pymysql://USER:PERCENT_ENCODED_PASSWORD@TIDB_HOST:4000/carepick
# Optional if TiDB uses a private CA; otherwise the OS certificate store is used.
TIDB_CA_PATH=
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
DEMO_ACCOUNTS_ENABLED=true
ADMIN_EMAIL=
ADMIN_PASSWORD=
MFDS_API_KEY=
SYNC_MAX_PAGES=10
S3_BUCKET=
AWS_REGION=ap-northeast-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# OAuth: register BACKEND_URL/api/auth/oauth/{provider}/callback with each provider.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# Render dashboard (register these variables individually; do NOT upload .env):
# APP_ENV=production, DATABASE_URL, JWT_SECRET, FRONTEND_URL=https://carepick.netlify.app,
# BACKEND_URL=https://carepick.onrender.com, ADMIN_EMAIL, ADMIN_PASSWORD,
# GOOGLE_CLIENT_ID/SECRET, NAVER_CLIENT_ID/SECRET, KAKAO_CLIENT_ID/SECRET (if used),
# TIDB_CA_PATH (only if a CA file is installed in the container).
# DEMO_ACCOUNTS_ENABLED=false in production. For isolated staging only: APP_ENV=staging,
# DEMO_ACCOUNTS_ENABLED=true. Never enable demo admin on a production database.
# Netlify dashboard: VITE_API_URL=https://carepick.onrender.com (public build-time variable).
# GitHub Actions secrets for sync: DATABASE_URL, MFDS_API_KEY; optional S3_BUCKET,
# AWS_REGION, AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY.
